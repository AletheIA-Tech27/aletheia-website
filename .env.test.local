# Email provider (Resend)
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY=

# Email de destino para los leads (OBLIGATORIO)
# Este es el único lugar donde se configura el email de destino
LEAD_DESTINATION_EMAIL=test@ejemplo.com

# URL pública del sitio (usada para sitemap, robots, metadata)
# En desarrollo: http://localhost:3000
# En producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000